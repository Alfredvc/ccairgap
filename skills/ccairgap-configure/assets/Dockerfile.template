 && test "$(codex --version | node -e 'const fs=require("node:fs");const input=fs.readFileSync(0,"utf8");const match=input.match(/(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)/);process.stdout.write(match?.[1] ?? "");')" = "$CODEX_VERSION"
